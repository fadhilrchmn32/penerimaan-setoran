# ==============================================================================
# FINOPS_SHARED_V1 — Konfigurasi Environment App 1 (Penerimaan & Setoran)
# Gunakan URL dan Publishable/Anon Key proyek Supabase YANG SAMA untuk App 1, 2, dan 3.
# JANGAN menuliskan service_role key atau database password di file frontend (.env).
# ==============================================================================

# URL Proyek Supabase bersama (wajib untuk mode produksi)
VITE_SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"

# Supabase Publishable Key (atau Anon Key publik dengan RLS aktif)
VITE_SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY"

# Opsional: Identitas tampilan aplikasi (tidak menggantikan nama di app_settings)
VITE_APP_NAME="Penerimaan & Setoran"
VITE_APP_CONTRACT_VERSION="1.0.0"

# Opsional: URL fallback aplikasi terkait jika belum diisi di app_settings database
VITE_APP2_URL=""
VITE_APP3_URL=""

# Server-side / Runtime AI Studio (jangan dikirim ke browser)
APP_URL="MY_APP_URL"
